rules_version = '2';

// Security rules for FestiChat group chat. Paste into Firebase console →
// Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;

      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /groups/{groupId} {
      // Group summary: member count and last message preview.
      allow read: if true;
      // Anyone signed in may change the member count; only members may set the last message.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberCount', 'lastMessage'])
        && (!('lastMessage' in request.resource.data) || isMember(groupId));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['memberCount', 'lastMessage'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage']) || isMember(groupId));

      match /members/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Anyone can read; only members can write, as themselves.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn() && isMember(groupId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
