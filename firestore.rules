rules_version = '2';

// Security rules for FestiChat group chat. Paste into Firebase console →
// Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // True when, inside the map `field`, only the caller's own entry changed.
    function onlyOwnEntry(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }
    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly(['name', 'bio', 'instagram', 'photo', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && optionalString(request.resource.data, 'bio', 160)
        && optionalString(request.resource.data, 'instagram', 30)
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 200000));
    }

    // Public profiles: anyone can read; only the owner writes their own.
    // `createdAt` (sign-up time) is set once, by the server clock.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && validProfile()
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if signedIn() && request.auth.uid == uid && validProfile()
        && (!changed().hasAny(['createdAt'])
            || (!('createdAt' in resource.data) && request.resource.data.createdAt == request.time));
      allow delete: if false;

      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Lets the admin page count messages across all groups (they are public anyway).
    match /{path=**}/messages/{messageId} {
      allow read: if true;
    }

    match /groups/{groupId} {
      // Group summary: member count, last message preview, pinned message.
      allow read: if true;
      // `endsAt` (when the event is over) is set by the first member and never changes.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberCount', 'lastMessage', 'pinned', 'endsAt'])
        && (request.resource.data.keys().hasOnly(['memberCount', 'endsAt']) || isMember(groupId));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['memberCount', 'lastMessage', 'pinned', 'endsAt'])
        && !(changed().hasAny(['endsAt']) && 'endsAt' in resource.data)
        && (changed().hasOnly(['memberCount', 'endsAt']) || isMember(groupId));

      match /members/{uid} {
        allow read: if true;
        // No new members once the event is over; existing members stay.
        allow create: if signedIn() && request.auth.uid == uid
          && request.time < getAfter(/databases/$(database)/documents/groups/$(groupId)).data.endsAt;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Anyone can read; only members can write, as themselves.
      match /messages/{messageId} {
        allow read: if true;

        allow create: if signedIn() && isMember(groupId)
          && request.resource.data.keys().hasOnly(
            ['uid', 'name', 'type', 'text', 'image', 'caption', 'poll', 'location', 'replyTo', 'reactions', 'votes', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'poll', 'location']
          && optionalString(request.resource.data, 'text', 1000)
          && optionalString(request.resource.data, 'caption', 1000)
          && optionalString(request.resource.data, 'image', 700000)
          && request.resource.data.reactions == {}
          && request.resource.data.votes == {}
          && request.resource.data.createdAt == request.time;

        allow update: if signedIn() && isMember(groupId) && (
          // The author may edit the text or delete the message.
          (resource.data.uid == request.auth.uid
            && changed().hasOnly(['text', 'edited', 'deleted', 'image', 'caption', 'poll', 'location'])
            && optionalString(request.resource.data, 'text', 1000))
          ||
          // Any member may set their own reaction or poll vote.
          (changed().hasOnly(['reactions', 'votes']) && onlyOwnEntry('reactions') && onlyOwnEntry('votes'))
        );

        allow delete: if false;
      }
    }
  }
}
